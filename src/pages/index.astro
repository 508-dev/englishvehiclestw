---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
const serviceEntries = await getCollection('service');
---

<Layout title="Taiwan English Services" description="Fluent English services with cars, motorcycles, and scooters in Taiwan. Includes renting, buying, selling, inspecting, repair, and maintenance.">
  <section class="hero">
    <div class="container hero__inner">
      <span class="hero__eyebrow">English &middot; Mandarin &middot; Taiwan</span>
      <h1>English-Language Car, Motorcycle, and Scooter Services in Taiwan</h1>
      <p class="lede">
        Interested in owning, or already own, a car, motorcycle, or scooter in Taiwan,
        and daunted by the labyrinthian Chinese-language bureaucracy? Let our bilingual
        English- and Mandarin-speaking staff help out.
      </p>
      <div class="hero__actions">
        <a href="/about/contact" class="button button--primary">Contact us today</a>
        <a href="#services" class="button button--ghost">See our services</a>
      </div>
    </div>
  </section>

  <section id="services" class="section">
    <div class="container">
      <h2>What we help with</h2>
      <p style="color: var(--color-text-muted); max-width: 40rem;">
        Whatever your motor vehicle related needs are in Taiwan, we can help.
        Browse our services below, or reach out for a free consultation.
      </p>
      <div class="service-grid" style="margin-top: 2rem;">
        { serviceEntries.map(service => (
          <article class="card">
            <h3>{service.data.title}</h3>
            <p>{service.data.description}</p>
            <div class="card__footer">
              <!-- {service.data.price -->
              <!--   ? <span class="card__price">NT${service.data.price}</span> -->
              <!--   : <span class="card__price">Free</span>} -->
              <a href={'/services/' + service.id} class="card__link">Read more &rarr;</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</Layout>
