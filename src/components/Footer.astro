---
import { getEntry, render } from 'astro:content';

const contactInfo = await getEntry('about', 'contact');
const { Content } = contactInfo ? await render(contactInfo) : { Content: null };
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div>
      <h2>Get in touch</h2>
      {Content && (
        <div class="prose">
          <Content />
        </div>
      )}
    </div>
    <div>
      <h2>Explore</h2>
      <ul class="site-footer__links">
        {contactInfo?.data.facebook && (
          <li><a href={contactInfo.data.facebook}>Facebook</a></li>
        )}
        <li><a href="/about/aboutus">About Us</a></li>
        <li><a href="/about/site">About This Site</a></li>
      </ul>
    </div>
  </div>
  <div class="container site-footer__bottom">
    &copy; 508.dev {new Date().getFullYear()}. English-language motor vehicle services in Taiwan.
  </div>
</footer>
